# 저장소 안에서는 LF 로 통일한다.
# Windows 에서 개발하지만(DEC-013) 줄바꿈이 커밋마다 뒤집히면 diff 를 읽을 수 없다.
* text=auto eol=lf

# 바이너리 — 정규화하지 않는다
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.pdf binary

# 자동 생성물 — diff 를 접어 둔다
_docs/_viewer/content.js  linguist-generated
_docs/_viewer/mermaid.min.js -diff linguist-vendored
project/package-lock.json -diff linguist-generated
