// Neowave Work 데이터 모델
// 정본: _docs/02.개발설계/02_데이터_모델.md (DEV-02)
//
// 명명 규칙: 테이블 snake_case 복수형 / 모델 PascalCase 단수 / 필드 camelCase + @map
// tsvector · GIN 인덱스 · 트리거는 Prisma 로 표현할 수 없어 마이그레이션 SQL 에 직접 씁니다
// (DEV-02 · 2.5절).

generator client {
  provider = "prisma-client-js"
  // 이 줄이 없으면 아래 datasource 의 `extensions` 가 유효하지 않아
  // `prisma validate` 가 바로 실패합니다. 빠뜨리기 쉬운 자리입니다.
  previewFeatures = ["postgresqlExtensions"]
}

// Prisma 7 부터 `url` 은 스키마에 두지 않습니다.
// 마이그레이션용 접속 URL은 `prisma.config.ts`, 런타임은 driver adapter(`src/lib/db.ts`).
datasource db {
  provider   = "postgresql"
  extensions = [pgTrgm(map: "pg_trgm"), unaccent]
}

// ───────── enum ─────────
/// `Role` 이 여기 있었습니다 (`MEMBER`·`EDITOR`·`ADMIN`). **지웠습니다** (`DEC-077`).
/// 이 시스템을 쓰는 «사람»은 운영자 한 명이고 나머지는 에이전트입니다 — 등급은
/// 여러 사람을 전제한 개념이라, 쓸 사람이 하나면 값이 하나뿐인 칸만 남습니다.
///
/// 「이 «키»가 무엇까지 할 수 있나」는 그대로 필요하고, 그 답은 **API 키의
/// 스코프**가 합니다 (`api_keys.scopes`). 역할이 스코프를 «제한»하던 것이
/// 없어졌을 뿐, 키마다 스코프를 «고르는» 것은 남습니다.
///
/// 과거 감사 로그의 `USER_ROLE_CHANGE` 행과 `diff.role` 은 그대로 읽힙니다 —
/// `audit_logs.action` 은 `String`, `diff` 는 `Json` 이라 이 타입에 매여 있지 않습니다.

/// 계정이 «지금 쓸 수 있는가». 가입 신청·승인 절차를 걷어내면서
/// `PENDING`·`REJECTED` 가 사라졌습니다 (`DEC-077`) — 신청이 없으니 대기도 거부도
/// 없고, 계정을 만드는 길은 시드 하나뿐입니다.
/// `WITHDRAWN` 은 남습니다: 이건 신청의 결말이 아니라 **계정의 끝**이고,
/// 즉시 마스킹 + 1년 뒤 익명화(`DEC-021`)가 그 위에 서 있습니다.
enum UserStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN
}

enum ResourceType {
  AI_MATERIAL
  GITHUB_REPO
  MCP_SERVER
  SKILL
  DEV_NOTE
  PROMPT
}

enum ResourceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

/// 자료가 들어온 경로. CLI 등록분을 구분하는 유일한 값 (DEC-029)
enum SourceChannel {
  WEB
  MCP
  IMPORT
}

/// 감사 로그의 수행 경로
enum ActorVia {
  WEB
  MCP
}

/// 컬렉션 전용. 자료에는 쓰지 않는다 (DEC-018)
enum Visibility {
  TEAM
  PRIVATE
}

enum SourceStatus {
  OK
  MOVED
  GONE
}

enum FileRole {
  ATTACHMENT
  ARCHIVE
  THUMBNAIL
}

enum RelationType {
  RELATED
  SOURCE_OF
  SUPERSEDES
  PART_OF
}

enum ArchiveStatus {
  NONE
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum JobType {
  FETCH_URL_META
  FETCH_GITHUB_META
  ARCHIVE_GITHUB
  /// 웹 페이지를 통째로 보관한다 — GitHub 이 아닌 자료의 `ARCHIVE_GITHUB`
  ARCHIVE_URL
  REFRESH_GITHUB_META
  CHECK_LINK
  GENERATE_THUMBNAIL
  CLEANUP_TRASH
}

enum JobStatus {
  QUEUED
  RUNNING
  DONE
  FAILED
}

enum UsageStatus {
  REVIEWING
  ADOPTED
  DEPRECATED
}

enum MaterialKind {
  PAPER
  ARTICLE
  VIDEO
  MODEL
  SERVICE
  COURSE
}

enum Language {
  KO
  EN
  ETC
}

enum McpTransport {
  STDIO
  SSE
  HTTP
}

enum NoteKind {
  CONVENTION
  TROUBLESHOOT
  TIP
  RETRO
}

/// `SIGNUP_REQUEST`·`APPROVED`·`REJECTED` 를 걷어냈습니다 (`DEC-077`) —
/// 셋 다 가입 신청·승인이 만들던 알림이고, 그 절차가 없어졌습니다.
enum NotificationType {
  JOB_DONE
  JOB_FAILED
  SYSTEM
}

// ───────── 계정 ─────────
model User {
  id                 String     @id @default(cuid())
  /// 로그인 아이디 (소문자 정규화). 이메일은 수집하지 않는다 (DEC-014)
  username           String     @unique
  passwordHash       String     @map("password_hash")
  name               String
  department         String?
  avatarUrl          String?    @map("avatar_url")
  bio                String?
  status             UserStatus @default(ACTIVE)
  statusReason       String?    @map("status_reason")
  statusChangedAt    DateTime?  @map("status_changed_at")
  statusChangedById  String?    @map("status_changed_by")
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  passwordChangedAt  DateTime?  @map("password_changed_at")
  lastLoginAt        DateTime?  @map("last_login_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  sessions          Session[]
  apiKeys           ApiKey[]
  resources         Resource[]         @relation("ResourceAuthor")
  bookmarks         Bookmark[]
  collections       Collection[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  uploadedFiles     File[]
  passwordHistories PasswordHistory[]
  revisions         ResourceRevision[]
  notes             Note[]

  /// 프로젝트 (`FR-PROJ-*`). 자료와 달리 **소유자는 지울 권한만** 갖습니다 —
  /// 보는 것도 고치는 것도 승인된 회원 전원입니다 (`DEC-018`·`DEC-069`)
  ownedProjects     Project[]          @relation("ProjectOwner")
  assignedItems     ProjectItem[]      @relation("ItemAssignee")
  itemComments      ProjectItemComment[] @relation("ProjectItemCommentAuthor")

  @@index([status])
  @@map("users")
}

/// 탈퇴한 계정의 아이디를 재사용하지 못하게 막는다 (DEC-021).
/// 아이디 중복 검사는 users 와 이 테이블을 **모두** 조회한다 (FR-AUTH-002).
model ReservedUsername {
  username   String   @id
  reservedAt DateTime @default(now()) @map("reserved_at")
  reason     String?

  @@map("reserved_usernames")
}

/// 비밀번호 재사용 방지 — 사용자별 최근 3개만 보관
model PasswordHistory {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("password_histories")
}

model ApiKey {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  name       String
  /// `nw_live_a1b2c3d4` — 조회·표시용 앞 자리
  keyPrefix  String    @map("key_prefix")
  /// SHA-256. 원문은 저장하지 않는다 (NFR-SEC-017)
  keyHash    String    @unique @map("key_hash")
  scopes     String[]
  lastUsedAt DateTime? @map("last_used_at")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  revokedBy  String?   @map("revoked_by")
  createdAt  DateTime  @default(now()) @map("created_at")

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@index([userId])
  @@map("api_keys")
}

/// 자체 세션 (DEC-030 — Auth.js 를 쓰지 않는다).
/// 토큰 원문은 쿠키에만 있고 여기에는 SHA-256 해시만 둔다.
model Session {
  id         String    @id @default(cuid())
  tokenHash  String    @unique @map("token_hash")
  userId     String    @map("user_id")
  expires    DateTime
  ip         String?
  userAgent  String?   @map("user_agent")
  lastSeenAt DateTime? @map("last_seen_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expires])
  @@map("sessions")
}

// ───────── 분류 ─────────
model Category {
  id          String  @id @default(cuid())
  parentId    String? @map("parent_id")
  name        String
  slug        String  @unique
  description String?
  /// lucide 아이콘명
  icon        String?
  sortOrder   Int     @default(0) @map("sort_order")
  isActive    Boolean @default(true) @map("is_active")

  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  resources Resource[]

  @@map("categories")
}

model Tag {
  id         String @id @default(cuid())
  slug       String @unique
  label      String
  usageCount Int    @default(0) @map("usage_count")

  resources ResourceTag[]

  @@map("tags")
}

// ───────── 자료 ─────────
model Resource {
  id              String         @id @default(cuid())
  type            ResourceType
  slug            String         @unique
  title           String
  summary         String?
  body            String?
  url             String?
  urlNormalized   String?        @map("url_normalized")
  thumbnailUrl    String?        @map("thumbnail_url")
  status          ResourceStatus @default(PUBLISHED)
  sourceChannel   SourceChannel  @default(WEB) @map("source_channel")
  categoryId      String?        @map("category_id")
  authorId        String         @map("author_id")
  /// 타입별 비정형 부가 정보. 구조가 정해진 값은 상세 테이블에 둔다
  metadata        Json?
  viewCount       Int            @default(0) @map("view_count")
  bookmarkCount   Int            @default(0) @map("bookmark_count")
  sourceStatus    SourceStatus?  @map("source_status")
  sourceCheckedAt DateTime?      @map("source_checked_at")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  deletedAt       DateTime?      @map("deleted_at")

  author   User      @relation("ResourceAuthor", fields: [authorId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])

  aiMaterial AiMaterial?
  githubRepo GithubRepo?
  mcpServer  McpServer?
  skill      Skill?
  devNote    DevNote?
  prompt     Prompt?

  tags            ResourceTag[]
  files           ResourceFile[]
  bookmarks       Bookmark[]
  revisions       ResourceRevision[]
  jobs            Job[]
  relationsFrom   ResourceRelation[] @relation("RelFrom")
  relationsTo     ResourceRelation[] @relation("RelTo")
  collectionItems CollectionItem[]

  @@index([type, createdAt(sort: Desc)])
  @@index([categoryId])
  @@index([authorId])
  @@index([status])
  @@index([sourceChannel])

  @@map("resources")
}

// search_vector 컬럼 · GIN 인덱스 · 갱신 트리거 · 부분 유니크 인덱스는
// Prisma 가 표현하지 못하므로 마이그레이션 SQL 에 직접 작성한다 (DEV-02 · 2.5절).

// ───────── 타입별 상세 ─────────
model AiMaterial {
  resourceId    String       @id @map("resource_id")
  materialKind  MaterialKind @map("material_kind")
  sourceName    String?      @map("source_name")
  authors       String[]
  publishedAt   DateTime?    @map("published_at")
  language      Language?
  readingTime   Int?         @map("reading_time")
  keyPoints     String?      @map("key_points")
  /// 사내 적용 아이디어. 이 시스템의 실제 가치다 (REQ-04 · 4.4절)
  applicability String?

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@map("ai_materials")
}

model GithubRepo {
  resourceId       String        @id @map("resource_id")
  owner            String
  repo             String
  defaultBranch    String?       @map("default_branch")
  stars            Int?
  forks            Int?
  primaryLanguage  String?       @map("primary_language")
  license          String?
  /// text[]. JSONB 안의 배열은 GIN 으로 검색되지 않는다
  topics           String[]
  pushedAt         DateTime?     @map("pushed_at")
  readmeContent    String?       @map("readme_content")
  readmeFetchedAt  DateTime?     @map("readme_fetched_at")
  /// 최상위 파일·폴더 목록 (`[{name,type,size}]`). 상세 화면이 GitHub 처럼
  /// 그립니다. **원본이 사라져도 «무엇이 있었는지»는 남습니다** — REQ-01 · 1.1
  /// 이 문제로 적어 둔 바로 그 상황입니다. 최상위만 둡니다: 전체 트리는
  /// 저장소 하나가 1만 줄이 넘고, 그걸 매 상세마다 실어 보내게 됩니다.
  fileTree         Json?         @map("file_tree")
  latestRelease    String?       @map("latest_release")
  archiveStatus    ArchiveStatus @default(NONE) @map("archive_status")
  archivedSha      String?       @map("archived_sha")
  /// 표시용 캐시. 정본은 files.size_bytes (role=ARCHIVE) — DEV-02 · 2.7절
  archiveSizeBytes BigInt?       @map("archive_size_bytes")
  isGone           Boolean       @default(false) @map("is_gone")

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  /// UNIQUE 였습니다. github_repos 에는 deleted_at 이 없어 그 유니크는
  /// **소프트 삭제를 볼 수 없었습니다** — 지웠다 다시 등록하면 30일간 P2002.
  /// 정체성은 resources(url_normalized) WHERE type=GITHUB_REPO 로 옮겼습니다 (DEC-050)
  @@index([owner, repo])
  @@map("github_repos")
}

model McpServer {
  resourceId     String       @id @map("resource_id")
  packageName    String?      @map("package_name")
  transport      McpTransport
  installCommand String?      @map("install_command")
  configJson     String       @map("config_json")
  /// [{key, description, required, example}] — **값은 저장하지 않는다** (NFR-SEC-008)
  envVars        Json?        @map("env_vars")
  /// [{name, description}]
  providedTools  Json?        @map("provided_tools")
  clientSupport  String[]     @map("client_support")
  usageStatus    UsageStatus  @default(REVIEWING) @map("usage_status")
  ownerUserId    String?      @map("owner_user_id")

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@map("mcp_servers")
}

model Skill {
  resourceId       String      @id @map("resource_id")
  skillName        String      @map("skill_name")
  /// Skill 정의 원문(마크다운). PROMPT 의 prompt_text 와 같은 자리
  definition       String
  triggerCondition String      @map("trigger_condition")
  targetClients    String[]    @map("target_clients")
  usageExample     String      @map("usage_example")
  usageStatus      UsageStatus @default(REVIEWING) @map("usage_status")
  version          String?

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@map("skills")
}

model DevNote {
  resourceId     String    @id @map("resource_id")
  noteKind       NoteKind  @map("note_kind")
  relatedProject String?   @map("related_project")
  occurredAt     DateTime? @map("occurred_at")

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@map("dev_notes")
}

model Prompt {
  resourceId  String      @id @map("resource_id")
  promptText  String      @map("prompt_text")
  useCase     String      @map("use_case")
  targetModel String?     @map("target_model")
  /// [{ name, description }]
  variables   Json?
  usageStatus UsageStatus @default(REVIEWING) @map("usage_status")

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@map("prompts")
}

// ───────── 연결 테이블 ─────────
model ResourceTag {
  resourceId String @map("resource_id")
  tagId      String @map("tag_id")

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([resourceId, tagId])
  /// tag_id 로 «시작하는» 길. PK 만으로는 태그 필터와 findRelated 가 연결
  /// 테이블 전체를 훑는다 — 10만 건에서 상세 화면이 164ms → 43ms (DEC-052)
  @@index([tagId, resourceId])
  @@map("resource_tags")
}

model ResourceRelation {
  id           String       @id @default(cuid())
  fromId       String       @map("from_resource_id")
  toId         String       @map("to_resource_id")
  relationType RelationType @map("relation_type")
  createdById  String?      @map("created_by")
  createdAt    DateTime     @default(now()) @map("created_at")

  from Resource @relation("RelFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to   Resource @relation("RelTo", fields: [toId], references: [id], onDelete: Cascade)

  @@unique([fromId, toId, relationType])
  @@map("resource_relations")
}

model File {
  id             String   @id @default(cuid())
  /// STORAGE_ROOT 아래 상대 경로. **서버가 생성한다** (NFR-SEC-019)
  storageKey     String   @unique @map("storage_key")
  originalName   String   @map("original_name")
  mimeType       String   @map("mime_type")
  sizeBytes      BigInt   @map("size_bytes")
  /// 중복 제거 키
  checksumSha256 String   @map("checksum_sha256")
  uploadedById   String   @map("uploaded_by")
  createdAt      DateTime @default(now()) @map("created_at")

  uploadedBy User           @relation(fields: [uploadedById], references: [id])
  resources  ResourceFile[]

  @@index([checksumSha256])
  @@map("files")
}

model ResourceFile {
  resourceId String   @map("resource_id")
  fileId     String   @map("file_id")
  role       FileRole
  sortOrder  Int      @default(0) @map("sort_order")

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  file     File     @relation(fields: [fileId], references: [id])

  @@id([resourceId, fileId, role])
  @@map("resource_files")
}

model Bookmark {
  userId     String   @map("user_id")
  resourceId String   @map("resource_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([userId, resourceId])
  @@map("bookmarks")
}

/// 개인 메모 (`FR-NOTE-001`~`005`). **자료가 아닙니다.**
///
/// `resources` 와 나란히 두지 않은 이유: 자료는 팀 카탈로그이고, 초안조차
/// `EDITOR` 이상이 전부 봅니다(`draftScope`). 「나만 보는」을 그 위에 얹으면
/// 규칙이 둘이 되고, 언젠가 한쪽만 고칩니다.
///
/// 검색·분류·태그·감사 로그에는 **아무 연결도 없습니다.**
model Note {
  id        String   @id @default(cuid())
  ownerId   String   @map("owner_id")
  title     String
  body      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  /// 휴지통 (`FR-NOTE-005`). **처음에는 없었습니다** — 「지우면 끝」으로
  /// 정했다가, 실수로 지운 메모를 되돌릴 길이 없어 겪고 나서 넣었습니다.
  ///
  /// 자료(`FR-RES-008`)와 달리 **자동으로 비우지 않습니다.** 30일 뒤 조용히
  /// 사라지는 것이 바로 이 기능이 생긴 이유이기 때문입니다. 비우는 것은
  /// 사람이 합니다.
  deletedAt DateTime? @map("deleted_at")

  /// 계정 행이 지워지면 메모도 함께. 다만 탈퇴는 «행 삭제»가 아니라
  /// 상태 전이라, 실제 삭제는 `member.service` 의 `WITHDRAW` 가 합니다
  owner User @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  /// 목록은 «내 것을 최근 수정순». 휴지통도 같은 표를 봅니다
  @@index([ownerId, updatedAt(sort: Desc)])
  @@map("notes")
}

model Collection {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  ownerId     String     @map("owner_id")
  visibility  Visibility @default(PRIVATE)
  coverUrl    String?    @map("cover_url")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  owner User             @relation(fields: [ownerId], references: [id])
  items CollectionItem[]

  @@map("collections")
}

model CollectionItem {
  collectionId String  @map("collection_id")
  resourceId   String  @map("resource_id")
  sortOrder    Int     @default(0) @map("sort_order")
  /// 담은 이유 메모
  note         String?

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  resource   Resource   @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@id([collectionId, resourceId])
  @@map("collection_items")
}

/// 전체 스냅샷이 아니라 변경된 필드만 저장한다
model ResourceRevision {
  id            String   @id @default(cuid())
  resourceId    String   @map("resource_id")
  editorId      String   @map("editor_id")
  /// { field: {before, after} }
  changedFields Json     @map("changed_fields")
  createdAt     DateTime @default(now()) @map("created_at")

  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  editor   User     @relation(fields: [editorId], references: [id])

  @@index([resourceId, createdAt(sort: Desc)])
  @@map("resource_revisions")
}

// ───────── 운영 ─────────
/// BullMQ 가 실제 큐를 관리하고, 이 테이블은 관리자 화면에서 보기 위한 기록이다
model Job {
  id            String    @id @default(cuid())
  type          JobType
  status        JobStatus @default(QUEUED)
  resourceId    String?   @map("resource_id")
  payload       Json?
  result        Json?
  errorMessage  String?   @map("error_message")
  attempts      Int       @default(0)
  startedAt     DateTime? @map("started_at")
  finishedAt    DateTime? @map("finished_at")
  requestedById String?   @map("requested_by")
  createdAt     DateTime  @default(now()) @map("created_at")

  resource Resource? @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([status, createdAt(sort: Desc)])
  @@map("jobs")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  body      String?
  linkUrl   String?          @map("link_url")
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model AuditLog {
  id            String   @id @default(cuid())
  actorId       String?  @map("actor_id")
  /// 스냅샷. 계정이 익명화돼도 추적할 수 있게 남긴다
  actorUsername String?  @map("actor_username")
  via           ActorVia @default(WEB)
  apiKeyId      String?  @map("api_key_id")
  action        String
  targetType    String?  @map("target_type")
  targetId      String?  @map("target_id")
  summary       String?
  diff          Json?
  ip            String?
  userAgent     String?  @map("user_agent")
  createdAt     DateTime @default(now()) @map("created_at")

  actor  User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  apiKey ApiKey? @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)

  @@index([createdAt(sort: Desc)])
  @@index([actorId])
  @@index([action])
  @@map("audit_logs")
}

/// 운영 설정만 담는다. 라벨·설명·아이콘은 코드 레지스트리가 단일 출처다 (DEC-032).
model ContentTypeSetting {
  type      ResourceType @id
  isActive  Boolean      @default(true) @map("is_active")
  showInNav Boolean      @default(true) @map("show_in_nav")
  sortOrder Int          @default(0) @map("sort_order")

  @@map("content_type_settings")
}

model SystemSetting {
  key         String   @id
  value       Json
  updatedById String?  @map("updated_by")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ───────────────────────── 프로젝트 (`FR-PROJ-*` · `DEC-069`) ─────────────────────────
//
// **`resources` 를 쓰지 않습니다.** 자료는 «바깥 어떤 것에 대한 문서»이고
// 프로젝트 문서는 «우리가 쓰는 글»입니다 — 분류·태그·중복 검사·수집 채널·
// 아카이브가 하나도 안 맞습니다. 그래서 표를 따로 둡니다.
//
// 날짜는 전부 `@db.Date` 입니다. 일정은 하루 단위인데 `timestamptz` 로 두면
// 「9월 3일」이 브라우저 시간대에 따라 2일·4일로 보이고 **간트 막대가 하루씩
// 밀립니다.**

enum ProjectStatus {
  PLANNED
  ACTIVE
  PAUSED
  DONE
}

model Project {
  id          String        @id @default(cuid())
  slug        String        @unique
  name        String
  description String?
  status      ProjectStatus @default(PLANNED)
  startsOn    DateTime?     @map("starts_on") @db.Date
  endsOn      DateTime?     @map("ends_on") @db.Date
  /// 만든 사람. **지울 권한이 여기서 나옵니다** — 보는 것도 고치는 것도 전원입니다
  ownerId     String        @map("owner_id")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  /// 휴지통 (`FR-PROJ-004`)
  deletedAt   DateTime?     @map("deleted_at")

  owner User          @relation("ProjectOwner", fields: [ownerId], references: [id])
  items ProjectItem[]

  /// `visibility` 가 **없습니다.** 승인된 회원 전원이 전부 봅니다 (`DEC-018`).
  /// 미리 두면 조회마다 조건이 붙고, 정작 필요한 날에는 **아무도 그 값을
  /// 채워 두지 않았다**는 것을 알게 됩니다.
  @@index([deletedAt, updatedAt(sort: Desc)])
  @@map("projects")
}



/// 프로젝트 항목 (`DEC-075` — gboard(Orbee) 의 `ProjectItem` 형태 그대로).
///
/// **간트의 막대 하나가 이 표의 한 줄입니다.** 계층·마일스톤·선후행은 두지
/// 않습니다 — Orbee 에 없는 것이고, 운영자가 그 형태를 그대로 쓰기로
/// 정했습니다(`DEC-075`). 진행률 하나로 상태를 나타냅니다.
model ProjectItem {
  id         String    @id @default(cuid())
  projectId  String    @map("project_id")
  title      String
  startsOn   DateTime? @map("starts_on") @db.Date
  endsOn     DateTime? @map("ends_on") @db.Date
  progress   Int       @default(0)
  /// 간트 막대 색. 비우면 벤더 기본색 (`DEC-074`)
  color      String?
  assigneeId String?   @map("assignee_id")
  /// 화면에 보이는 차례. Orbee 의 `position` 과 같은 몫이다
  sortOrder  Int       @default(0) @map("sort_order")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation("ItemAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  comments ProjectItemComment[]

  @@index([projectId, sortOrder])
  @@index([assigneeId])
  @@map("project_items")
}


/// 항목 댓글 (`DEC-074` — gboard 의 `ProjectItemComment` 을 우리 모델에 맞춘 것).
///
/// **`resources` 밖에 있습니다** (`DEC-069`). 자료의 댓글이 아니라 일정의 댓글이고,
/// 검색 대상도 아닙니다.
///
/// 지우기는 **soft delete** 입니다 — 다른 표(`project_docs`·`project_tasks`)와
/// 같은 규칙이라야 「지운 것」의 뜻이 표마다 갈라지지 않습니다.
model ProjectItemComment {
  id        String    @id @default(cuid())
  itemId    String    @map("item_id")
  authorId  String    @map("author_id")
  body      String
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  item   ProjectItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  author User        @relation("ProjectItemCommentAuthor", fields: [authorId], references: [id])

  /// 한 항목의 댓글을 시간순으로 — 목록이 유일한 읽기 경로다
  @@index([itemId, deletedAt, createdAt])
  @@map("project_item_comments")
}
