# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
packages/*/node_modules

# workspace 패키지 빌드 산출물 — 원본은 src/ 다. 받는 쪽이 `npm run build` 를 돌린다
packages/*/dist
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# **예시는 커밋합니다** (NFR-SEC-012). 이 한 줄이 없으면 위 `.env*` 가 함께
# 삼켜서, 새로 받은 사람이 무엇을 채워야 하는지 알 방법이 없습니다.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright (E2E 산출물 — 실패한 것의 스크린샷·트레이스)
test-results/
playwright-report/
.playwright/

# Playwright MCP 가 남기는 콘솔·스냅샷 로그 (디오가 페이지를 열 때)
.playwright-mcp/

# 디오가 저장소 루트에 떨어뜨린 캡처 (지금은 STORAGE_ROOT/chat-shots 로 갑니다)
/*.png
/*.jpg

# 디오 브라우저의 프로필 (STORAGE_ROOT 밖에 잘못 생겼을 때 대비)
chat-browser-profile/
