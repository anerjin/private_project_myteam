# Neowave Work 환경 변수 (DEV-01 · 1.8절)
#
# 이 파일을 `project/.env` 로 복사해 채웁니다. `.env` 는 커밋하지 않습니다 (NFR-SEC-012).
# 앱 기동 시 `src/lib/env.ts` 가 zod 로 검증하고, 실패하면 즉시 종료합니다 (NFR-MAINT-006).

# ── 기본 ────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3100
LOG_LEVEL=debug

# ── 데이터 ──────────────────────────────────────────
# docker/docker-compose.dev.yml 의 기본값과 맞춰야 합니다.
# 포트가 5433·6380 인 이유: 이 PC 의 다른 프로젝트가 5432·6379 를 쓰고 있습니다 (DEC-033).
DATABASE_URL=postgresql://neowave_work:neowave_work@localhost:5433/neowave_work
REDIS_URL=redis://localhost:6380

# ── 세션 (DEC-030 — Auth.js 를 쓰지 않습니다) ────────
# 세션 토큰은 서명하지 않는 불투명 난수라 AUTH_SECRET 이 필요 없습니다.
SESSION_COOKIE_NAME=nw_session
SESSION_TTL_DAYS=7
# 1단계는 http 로 운영하므로 false 입니다. 2단계(HTTPS)에서 true (NFR-SEC-005).
COOKIE_SECURE=false

# ── 파일 저장 (DEC-019) ─────────────────────────────
STORAGE_DRIVER=local
# 저장소 폴더. 저장소 «밖»에 둡니다 — 백업 대상이 명확해지고 git 에 섞이지 않습니다.
STORAGE_ROOT=E:\neowave-work-data\files
MAX_UPLOAD_MB=50
MAX_ARCHIVE_MB=500
DISK_MIN_FREE_GB=20

# ── 외부 연동 ───────────────────────────────────────
# 조직 fine-grained PAT (DEC-020). 없으면 미인증으로 동작하고 rate limit 이 낮습니다.
GITHUB_TOKEN=

# ── 최초 관리자 시드 (DEC-014 — 아이디 기반) ─────────
# 계정이 **없을 때만** 만듭니다. 이미 있으면 시드는 아무것도 하지 않습니다
# (`prisma/seed.ts` 의 `update: {}`) — 비밀번호를 되돌리는 용도가 아닙니다.
ADMIN_SEED_ID=master
# 10자 미만이면 `lib/env.ts` 가 기동을 막고 시드도 거부합니다 (REQ-02 · 2.9 비밀번호 규칙).
ADMIN_SEED_PASSWORD=change-me-on-first-login
# 가짜 사람(minsu·seoyeon)을 만들지 않습니다 (DEC-063).
# 개발 중 필요하면 true 로 되돌리고 시드를 다시 돌리십시오: npx prisma db seed
SEED_DEV_USERS=false

# 리버스 프록시 뒤에 두면 true — 클라이언트 IP 를 X-Forwarded-For 에서 읽습니다.
# 프록시가 없는데 true 로 두면 **IP 를 헤더로 위조할 수 있습니다** (NFR-SEC-002 우회).
TRUST_PROXY=false

# ── 도우미 채팅 ────────────────────────────────────
# 이 PC 에 설치된 **Claude Code CLI** 를 헤드리스로 부릅니다.
# 모델 호출 자격은 CLI 가 이미 갖고 있으므로(`claude auth`) 모델 API 키를 두지 않습니다.
#
# 아래는 Neowave Work **자기 자신의 읽기 전용 API 키**입니다 — CLI 가 MCP 로 자료를
# 찾을 때만 씁니다. 비우면 채팅은 뜨지만 검색 없이 답하고, 화면이 그 사실을 말합니다.
# 마이페이지 > 보안 > API 키에서 `resources:read` 하나만 주어 발급하십시오.
CHAT_API_KEY=
# CLI 실행 파일을 못 찾을 때만 지정합니다 (보통 비워 둡니다).
# CLAUDE_BIN=

# ── MCP 서버 쪽 (개발자 PC 의 Claude Code 설정에 넣는 값) ──
# NEOWAVE_WORK_URL=http://localhost:3100
# NEOWAVE_WORK_API_KEY=nw_live_...

# 네오에게 브라우저를 준다 (1=켜짐). 기본은 꺼짐 — OPS-01 10장
# 켜면 네오가 웹 페이지를 직접 열어 봅니다. 로그인 없는 격리 프로필이고
# 사내망은 늘 막힙니다. npm run verify:chat 이 실제로 붙었는지 셉니다.
CHAT_BROWSER=
# 여는 곳을 좁히려면 (세미콜론). 비우면 바깥 전체
CHAT_BROWSER_ALLOW=
# 브라우저 창을 «서버 PC 화면»에 띄운다 (1=켜짐). 기본은 안 띄움
# 안 띄워도 캡처는 답에 그림으로 붙습니다 — 사내망 팀원은 그쪽만 봅니다
CHAT_BROWSER_HEADED=
# 네오의 브라우저 서버가 듣는 포트 (기본 3101). 창을 띄우는 설정이면
# 그 다음 번호(3102)로 디버깅 포트도 엽니다 — 둘 다 이 PC 안에서만 듣습니다
CHAT_BROWSER_PORT=

# 네오의 목소리 — Supertonic 모델 폴더 (OPS-01 10장). npm run tts:model 이
# 내려받고 이 줄에 적을 값을 찍어 줍니다. 비우면 브라우저 내장 목소리를 씁니다
TTS_MODEL_DIR=
