{
  "name": "queenbee",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start -p 3100",
    "lint": "eslint --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "check:deps": "node scripts/check-deps.mjs",
    "check:guards": "node scripts/check-page-guards.mjs",
    "check:fr": "node scripts/check-fr-coverage.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run typecheck && npm run lint && npm run check:deps && npm run check:guards && npm run check:fr && npm run build",
    "verify:p3": "tsx --conditions=react-server --env-file=.env scripts/verify-p3.ts",
    "verify:p3-keys": "tsx --conditions=react-server --env-file=.env scripts/verify-p3-keys.ts",
    "verify:p4": "tsx --conditions=react-server --env-file=.env scripts/verify-p4.ts",
    "verify:p5": "tsx --conditions=react-server --env-file=.env scripts/verify-p5.ts",
    "verify:p7": "tsx --conditions=react-server --env-file=.env scripts/verify-p7.ts",
    "maintenance": "tsx --conditions=react-server --env-file=.env scripts/maintenance.ts",
    "seed:collect-skill": "tsx --conditions=react-server --env-file=.env scripts/register-collect-skill.ts",
    "verify:p8": "tsx --conditions=react-server --env-file=.env scripts/verify-p8.ts",
    "verify:p7-mcp": "npm run --workspace @queenbee/mcp build && tsx --conditions=react-server --env-file=.env scripts/verify-p7-mcp.ts",
    "verify:p6": "tsx --conditions=react-server --env-file=.env scripts/verify-p6.ts",
    "verify:empty-db": "tsx --conditions=react-server --env-file=.env scripts/verify-empty-db.ts",
    "bench:list": "tsx --conditions=react-server --env-file=.env scripts/bench-list.ts",
    "db:up": "docker compose -f ../docker/docker-compose.dev.yml up -d",
    "db:down": "docker compose -f ../docker/docker-compose.dev.yml down"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@node-rs/argon2": "^2.1.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@tanstack/react-table": "^9.2.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.34.0",
    "next": "16.3.3",
    "next-themes": "^0.4.6",
    "pg": "8.23.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "server-only": "^0.0.1",
    "shadcn": "^4.19.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
