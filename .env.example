# Neowave Work 환경 변수 (DEV-01 · 1.8절)
#
# 이 파일을 `project/.env` 로 복사해 채웁니다. `.env` 는 커밋하지 않습니다 (NFR-SEC-012).
# 앱 기동 시 `src/lib/env.ts` 가 zod 로 검증하고, 실패하면 즉시 종료합니다 (NFR-MAINT-006).

# ── 앱 ─────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3100
LOG_LEVEL=debug

# ── 데이터 ─────────────────────────────────────────
# docker/docker-compose.dev.yml 의 기본값과 맞춥니다.
# 포트가 5433·6380 인 이유: 이 PC의 다른 프로젝트가 5432·6379 를 쓰고 있습니다 (DEC-033).
DATABASE_URL=postgresql://neowave_work:neowave_work@localhost:5433/neowave_work
REDIS_URL=redis://localhost:6380

# ── 세션 (DEC-030 — Auth.js 를 쓰지 않습니다) ──────
# 세션 토큰은 서명하지 않는 불투명 난수라 AUTH_SECRET 이 필요 없습니다.
SESSION_COOKIE_NAME=nw_session
# REQ-02 · 2.7 이 7일로 정했습니다.
SESSION_TTL_DAYS=7
# 1단계는 http 로 운영하므로 끕니다. 2단계(HTTPS)에서 true (NFR-SEC-005).
COOKIE_SECURE=false

# ── 파일 저장 (DEC-019) ────────────────────────────
STORAGE_DRIVER=local
# 저장소 폴더 «밖»에 둡니다. 백업 대상이 명확해지고 git 에 섞이지 않습니다.
STORAGE_ROOT=E:\neowave-work-data\files
MAX_UPLOAD_MB=50
MAX_ARCHIVE_MB=500
DISK_MIN_FREE_GB=20

# ── 외부 연동 ──────────────────────────────────────
# 조직 fine-grained PAT (DEC-020). 없으면 미인증 호출로 동작하고 rate limit 이 낮습니다.
GITHUB_TOKEN=

# ── 최초 관리자 시드 (DEC-014 — 아이디 기반) ───────
ADMIN_SEED_ID=admin
ADMIN_SEED_PASSWORD=change-me-on-first-login

# 개발 계정(minsu=MEMBER, seoyeon=EDITOR)을 만들지 여부. 비밀번호는 neowave-work-dev-1234.
# **명시적 옵트인입니다** — NODE_ENV 판정에 기대면 운영에서 조용히 돌 수 있습니다.
SEED_DEV_USERS=true

# x-forwarded-for 를 믿을지. 리버스 프록시가 붙는 2단계에서만 켭니다.
# 1단계에서 켜면 누구나 헤더를 위조해 IP 레이트리밋을 무력화할 수 있습니다.
TRUST_PROXY=false

# ── MCP 서버 쪽 (개발자 PC의 Claude Code 설정에 넣는 값) ──
# NEOWAVE_WORK_URL=http://localhost:3100
# NEOWAVE_WORK_API_KEY=nw_live_...
