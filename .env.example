# QueenBee 환경 변수 (DEV-01 · 1.8절)
#
# 이 파일을 `project/.env` 로 복사해 채웁니다. `.env` 는 커밋하지 않습니다 (NFR-SEC-012).
# 앱 기동 시 `src/lib/env.ts` 가 zod 로 검증하고, 실패하면 즉시 종료합니다 (NFR-MAINT-006).

# ── 앱 ─────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3100
LOG_LEVEL=debug

# ── 데이터 ─────────────────────────────────────────
# docker/docker-compose.dev.yml 의 기본값과 맞춥니다.
# 포트가 5433·6380 인 이유: 이 PC의 다른 프로젝트가 5432·6379 를 쓰고 있습니다 (DEC-033).
DATABASE_URL=postgresql://queenbee:queenbee@localhost:5433/queenbee
REDIS_URL=redis://localhost:6380

# ── 세션 (DEC-030 — Auth.js 를 쓰지 않습니다) ──────
# 세션 토큰은 서명하지 않는 불투명 난수라 AUTH_SECRET 이 필요 없습니다.
SESSION_COOKIE_NAME=qb_session
# REQ-02 · 2.7 이 7일로 정했습니다.
SESSION_TTL_DAYS=7
# 1단계는 http 로 운영하므로 끕니다. 2단계(HTTPS)에서 true (NFR-SEC-005).
COOKIE_SECURE=false

# ── 파일 저장 (DEC-019) ────────────────────────────
STORAGE_DRIVER=local
# 저장소 폴더 «밖»에 둡니다. 백업 대상이 명확해지고 git 에 섞이지 않습니다.
STORAGE_ROOT=E:\queenbee-data\files
MAX_UPLOAD_MB=50
MAX_ARCHIVE_MB=500
DISK_MIN_FREE_GB=20

# ── 외부 연동 ──────────────────────────────────────
# 조직 fine-grained PAT (DEC-020). 없으면 미인증 호출로 동작하고 rate limit 이 낮습니다.
GITHUB_TOKEN=

# ── 최초 관리자 시드 (DEC-014 — 아이디 기반) ───────
ADMIN_SEED_ID=admin
ADMIN_SEED_PASSWORD=change-me-on-first-login

# ── MCP 서버 쪽 (개발자 PC의 Claude Code 설정에 넣는 값) ──
# QUEENBEE_URL=http://localhost:3100
# QUEENBEE_API_KEY=qb_live_...
